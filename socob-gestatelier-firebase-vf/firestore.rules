rules_version = '2';

// Baseline rules for the workshop management app.
// Data is only readable/writable by authenticated users of the app.
// Adjust to your exact auth model (roles, per-workshop tenancy, etc.)
// before going to production.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{collection}/{docId} {
      allow read, write: if request.auth != null;
    }
  }
}
